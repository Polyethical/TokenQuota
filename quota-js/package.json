{
  "name": "tokenquota",
  "version": "0.1.0",
  "description": "Per-user token and dollar budgets for AI apps, enforced before the model call. Client for tokenquota-server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/client.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": ["llm", "quota", "usage-limits", "openai", "anthropic", "vercel-ai-sdk", "nextjs"],
  "author": "YOUR NAME",
  "license": "MIT",
  "homepage": "https://github.com/YOUR-ORG/quota-js#readme",
  "repository": { "type": "git", "url": "git+https://github.com/YOUR-ORG/quota-js.git" },
  "bugs": { "url": "https://github.com/YOUR-ORG/quota-js/issues" },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
